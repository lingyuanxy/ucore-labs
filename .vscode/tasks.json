{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uCore: build lab2",
      "type": "process",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/code"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "uCore: run lab2 (QEMU)",
      "type": "process",
      "command": "make",
      "args": [
        "qemu"
      ],
      "options": {
        "cwd": "${workspaceFolder}/code"
      },
      "problemMatcher": []
    },
    {
      "label": "uCore: debug server lab2",
      "type": "process",
      "command": "make",
      "args": [
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/code"
      },
      "problemMatcher": []
    },
    {
      "label": "uCore: GDB lab2",
      "type": "process",
      "command": "make",
      "args": [
        "gdb"
      ],
      "options": {
        "cwd": "${workspaceFolder}/code"
      },
      "problemMatcher": []
    }
  ]
}
