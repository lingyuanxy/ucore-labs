{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "uCore lab2 (preserved partner code)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/lab2/code/bin/kernel",
      "cwd": "${workspaceFolder}/lab2/code",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": false,
      "externalConsole": false,
      "launchCompleteCommand": "None",
      "postRemoteConnectCommands": [
        {
          "description": "Break at the real virtual C entry",
          "text": "-break-insert -h kern_init",
          "ignoreFailures": false
        },
        {
          "description": "Observe the unchanged Buddy checks",
          "text": "-break-insert -h buddy_check",
          "ignoreFailures": false
        },
        {
          "description": "Observe the unchanged SLUB checks",
          "text": "-break-insert -h slub_check",
          "ignoreFailures": false
        }
      ]
    }
  ]
}
