# Zhu Zhongming: Makefile.local.zhuzhongming.example
# Makefile.local is ignored by Git. Command-line assignments take precedence.
# Generic configuration for other computers:
QEMU := /opt/qemu-4.1.1/bin/qemu-system-riscv64
# GCCPREFIX := /your/toolchain/bin/riscv64-unknown-elf-
# GDB := /your/toolchain/bin/riscv64-unknown-elf-gdb
QEMU_LOAD := loader
